# --- secrets (jamais commites) ---
.env
client_secret.json
token.json

# --- medias : des gigaoctets de video, tout est regenerable ---
media/

# --- journaux et fichiers generes ---
*.log
dashboard.html
history.json

# --- archives et copies de sauvegarde locales ---
*.rar
*.zip
* - Copie/

# --- Python ---
__pycache__/
*.pyc
.venv/
.probe_cache/

# --- app Flutter : artefacts recrees par `flutter build` ---
app/build/
app/.dart_tool/
app/windows/flutter/ephemeral/
app/.flutter-plugins*
*.iml
